# [livingworld] world-generation test (tools/livingworld/server_test.sh <jar> tools/livingworld/worldgen_test.commands <dir>)
# console source sits at world spawn; "~" = spawn height
fhqa registry
frontierhunts sites
frontierhunts sites spawn
#sleep 2
locate structure frontierhunts:hunting_camp
locate structure frontierhunts:abandoned_camp
locate structure frontierhunts:elk_camp
locate structure frontierhunts:outfitter_post
locate structure frontierhunts:ranger_station
locate structure frontierhunts:trapper_cabin
locate structure frontierhunts:meat_shed
locate structure frontierhunts:trailhead
locate structure frontierhunts:stand_line
locate structure frontierhunts:ground_blind_plot
locate structure frontierhunts:duck_blind
locate structure frontierhunts:glassing_point
locate structure frontierhunts:fence_line
locate structure frontierhunts:antler_cache
#sleep 3
# naturally generate a block of new chunks (sites appear as in normal play / Distant Horizons)
forceload add -128 -128 127 127
#sleep 150
fhqa count minecraft:overworld
forceload add 1000 1000
#sleep 6
place structure frontierhunts:hunting_camp 1000 ~ 1000
#sleep 3
forceload remove 1000 1000
#sleep 4
forceload add 1200 1000
#sleep 6
place structure frontierhunts:abandoned_camp 1200 ~ 1000
#sleep 3
forceload remove 1200 1000
#sleep 4
forceload add 1400 1000
#sleep 6
